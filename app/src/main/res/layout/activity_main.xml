<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#080D12"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOTOPRO"
        android:textColor="#42D6C5"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cámara inteligente · Modo automático"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:background="@drawable/fotopro_camera_switch_bg"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Cambiar entre cámara principal y selfie"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Las fotos mejoradas se guardarán en Pictures/FOTOPRO"
        android:textColor="#C6D0D9"
        android:gravity="center"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <Button
            android:id="@+id/photoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:layout_marginEnd="5dp"
            android:text="FOTO" />

        <Button
            android:id="@+id/videoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:layout_marginStart="5dp"
            android:text="GRABAR VIDEO" />
    </LinearLayout>
</LinearLayout>

